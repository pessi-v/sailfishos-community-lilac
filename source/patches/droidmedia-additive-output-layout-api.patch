+void droid_media_codec_get_output_layout(DroidMediaCodec *codec, DroidMediaCodecOutputLayout *layout)
+{
+  android::sp<android::MetaData> md(codec->m_codec->getFormat());
+
+  layout->stride = -1;
+  layout->slice_height = -1;
+  md->findInt32(android::kKeyStride, &layout->stride);
+  md->findInt32(android::kKeySliceHeight, &layout->slice_height);
+}
