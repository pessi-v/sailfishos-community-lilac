diff --git a/droidmediacodec.h b/droidmediacodec.h
index e9bb10c..1d31247 100644
--- a/droidmediacodec.h
+++ b/droidmediacodec.h
@@ -59,9 +59,18 @@ typedef struct {
   int32_t sample_rate;
   int32_t hal_format;
   DroidMediaCodecFlags flags;
+} DroidMediaCodecMetaData;
+
+/* Row stride and padded slice height of the decoder output buffers, as reported by the codec's output
+ * format. Each member is -1 when the codec does not report it.
+ *
+ * This is deliberately a separate struct and not part of DroidMediaCodecMetaData: that struct is embedded
+ * as the first member of DroidMediaCodecDecoderMetaData and DroidMediaCodecEncoderMetaData, so adding
+ * members to it moves every following member of both and breaks binaries built against the old header. */
+typedef struct {
   int32_t stride;
   int32_t slice_height;
-} DroidMediaCodecMetaData;
+} DroidMediaCodecOutputLayout;
 
 typedef struct {
   DroidMediaCodecMetaData parent;
@@ -128,6 +137,7 @@ void droid_media_codec_flush(DroidMediaCodec *codec);
