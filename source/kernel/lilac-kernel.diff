+		ufshcd_release_all(hba);
+	}
+	if (err)
+		dev_err(hba->dev, "%s: device detection failed after %d retries (%d)\n",
+			__func__, UFSHCD_LILAC_DETECT_RETRIES, err);
+	else
+		dev_err(hba->dev, "%s: device detected after %d retry(ies)\n",
