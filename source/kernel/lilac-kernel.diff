+static void lilac_detect_retry_fn(struct work_struct *w)
+{
+	struct ufs_hba *hba = lilac_detect_hba;
+	int i, err = -EIO;
+
+	for (i = 1; err && i <= UFSHCD_LILAC_DETECT_RETRIES; i++) {
+		dev_err(hba->dev, "%s: retry %d/%d with full device reset\n",
+			__func__, i, UFSHCD_LILAC_DETECT_RETRIES);
+		ufshcd_hold_all(hba);
+		/* ufshcd_probe_hba() drops one runtime-PM reference on every exit here */
+		pm_runtime_get_sync(hba->dev);
