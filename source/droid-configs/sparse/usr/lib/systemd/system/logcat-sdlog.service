[Unit]
Description=Stream Android logcat to persistent storage for crash diagnosis (testmode)
DefaultDependencies=no
After=droid-hal-init.service
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/bin/sh /usr/local/bin/logcat-sdlog.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
