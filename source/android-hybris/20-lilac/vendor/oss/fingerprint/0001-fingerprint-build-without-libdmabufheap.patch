From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:31:43 +0000
Subject: [PATCH] (lilac) fingerprint: build without libdmabufheap and the VINTF fragment

libdmabufheap does not exist in this Android 11 tree (and the 4.14
kernel has no DMA-BUF heaps). Only the egistec sensor code uses it, which
yoshino never selects at run time, but service.cpp includes all sensor
implementations, so it must still link. dmabufheap-compat/ provides the
one BufferAllocator call it needs on top of the DMA-BUF heap ioctls; on
this kernel it fails cleanly because /dev/dma_heap does not exist.

The module's VINTF fragment duplicates the fingerprint HAL that the
device manifest already declares. hwservicemanager then rejects the
whole device manifest ("HAL ... has a conflict"), which breaks every
HAL lookup, so the fragment is not installed.
---
 Android.mk                                         |    4 
 dmabufheap-compat/BufferAllocator.cpp              |  183 ++++++++++++++++++++
 .../BufferAllocator/BufferAllocator.h              |   68 +++++++
 .../BufferAllocator/BufferAllocatorWrapper.h       |   31 +++
 4 files changed, 284 insertions(+), 2 deletions(-)

diff --git a/Android.mk b/Android.mk
index 176310dc2b71aa16db6f572cdf602057b53dd7c1..514ce8a184a0af6340afd61a50d6cfdc0fbe8002 100644
--- a/Android.mk
+++ b/Android.mk
@@ -5,7 +5,6 @@ LOCAL_PATH := $(call my-dir)
 include $(CLEAR_VARS)
 LOCAL_MODULE := android.hardware.biometrics.fingerprint@2.1-service.sony
 LOCAL_INIT_RC := android.hardware.biometrics.fingerprint@2.1-service.sony.rc
-LOCAL_VINTF_FRAGMENTS := android.hardware.biometrics.fingerprint.xml
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MODULE_RELATIVE_PATH := hw
 LOCAL_SRC_FILES := \
@@ -13,6 +12,8 @@ LOCAL_SRC_FILES := \
     QSEEComFunc.c \
     common.c
 
+LOCAL_C_INCLUDES += $(LOCAL_PATH)/dmabufheap-compat
+
 # ---------------- FPC ----------------
 ifeq ($(filter-out loire tone,$(SOMC_PLATFORM)),)
 LOCAL_SRC_FILES += fpc_imp_loire_tone.c
@@ -87,7 +88,6 @@ LOCAL_SHARED_LIBRARIES := \
     android.hardware.biometrics.fingerprint@2.1 \
     libcutils \
     libdl \
-    libdmabufheap \
     libhardware \
     libhidlbase \
     liblog \
diff --git a/dmabufheap-compat/BufferAllocator.cpp b/dmabufheap-compat/BufferAllocator.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..adad010b3dfc82f3560dc107b04f1e897860d23f
--- /dev/null
+++ b/dmabufheap-compat/BufferAllocator.cpp
@@ -0,0 +1,183 @@
+/*
+ * Minimal compat implementation of AOSP's libdmabufheap BufferAllocator, for
+ * a tree that doesn't have the real library. See BufferAllocator.h for why,
+ * including why the ION fallback path below is real, load-bearing code and
+ * not a stub for dead code.
+ *
+ * Real DMA-BUF Heaps UAPI (stable since upstream Linux 5.6, standard
+ * <linux/dma-heap.h> -- not present in this 4.14 kernel's own UAPI headers,
+ * so the ioctl numbers are reproduced directly here rather than included).
+ *
+ * ION legacy-ABI UAPI: reproduced from the kernel's drivers/staging/android/ion/ion_legacy.h (the
+ * kernel-side compat patch that makes this ABI available at all on this
+ * tree) -- kept independent rather than #include-ing across the kernel/
+ * userspace boundary, same as that file's own approach.
+ */
+#include "BufferAllocator/BufferAllocator.h"
+#include "BufferAllocator/BufferAllocatorWrapper.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+namespace {
+
+struct dma_heap_allocation_data {
+    uint64_t len;
+    uint32_t fd;
+    uint32_t fd_flags;
+    uint64_t heap_flags;
+};
+
+#define DMA_HEAP_IOC_MAGIC 'H'
+#define DMA_HEAP_IOCTL_ALLOC _IOWR(DMA_HEAP_IOC_MAGIC, 0x0, struct dma_heap_allocation_data)
+
+typedef int ion_user_handle_t;
+
+struct ion_legacy_allocation_data {
+    uint64_t len;
+    uint64_t align;
+    uint32_t heap_id_mask;
+    uint32_t flags;
+    ion_user_handle_t handle;
+};
+
+struct ion_legacy_fd_data {
+    ion_user_handle_t handle;
+    int fd;
+};
+
+#define ION_LEGACY_IOC_MAGIC 'I'
+#define ION_LEGACY_IOC_ALLOC _IOWR(ION_LEGACY_IOC_MAGIC, 0, struct ion_legacy_allocation_data)
+#define ION_LEGACY_IOC_MAP _IOWR(ION_LEGACY_IOC_MAGIC, 2, struct ion_legacy_fd_data)
+
+// msm8998-ion.dtsi's own DT node comment/reg for the heap we need:
+//   qcom,ion-heap@27 { /* QSEECOM HEAP */ reg = <27>; ... };
+constexpr unsigned int kQseecomIonHeapId = 27;
+
+}  // namespace
+
+BufferAllocator::~BufferAllocator() {
+    if (heap_fd >= 0) {
+        close(heap_fd);
+    }
+}
+
+int BufferAllocator::AllocFromIon(unsigned int ion_heap_id, size_t len, unsigned int flags) {
+    int ion_fd = open("/dev/ion", O_RDONLY | O_CLOEXEC);
+    if (ion_fd < 0) {
+        return -errno;
+    }
+
+    struct ion_legacy_allocation_data alloc_data = {};
+    alloc_data.len = len;
+    alloc_data.align = 0;
+    alloc_data.heap_id_mask = 1u << ion_heap_id;
+    alloc_data.flags = flags;
+
+    if (ioctl(ion_fd, ION_LEGACY_IOC_ALLOC, &alloc_data) < 0) {
+        int err = errno;
+        close(ion_fd);
+        return -err;
+    }
+
+    struct ion_legacy_fd_data map_data = {};
+    map_data.handle = alloc_data.handle;
+    if (ioctl(ion_fd, ION_LEGACY_IOC_MAP, &map_data) < 0) {
+        int err = errno;
+        close(ion_fd);
+        return -err;
+    }
+
+    close(ion_fd);
+    return map_data.fd;
+}
+
+int BufferAllocator::Alloc(const std::string &heap_name, size_t len, unsigned int heap_flags,
+                            unsigned int alloc_flags) {
+    (void)alloc_flags;
+
+    auto it = ion_heap_ids.find(heap_name);
+    if (it != ion_heap_ids.end()) {
+        return AllocFromIon(it->second, len, heap_flags);
+    }
+
+    std::string heap_path = "/dev/dma_heap/" + heap_name;
+    int fd = open(heap_path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        // No CONFIG_DMABUF_HEAPS on this kernel and no recorded ION mapping
+        // for this heap name -- the real library would fail exactly the
+        // same way on a kernel lacking both.
+        return -errno;
+    }
+
+    struct dma_heap_allocation_data data = {};
+    data.len = len;
+    data.fd_flags = O_RDWR | O_CLOEXEC;
+    data.heap_flags = heap_flags;
+
+    int ret = ioctl(fd, DMA_HEAP_IOCTL_ALLOC, &data);
+    close(fd);
+    if (ret < 0) {
+        return -errno;
+    }
+    return static_cast<int>(data.fd);
+}
+
+bool BufferAllocator::CheckIonSupport() {
+    int fd = open("/dev/ion", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    close(fd);
+    return true;
+}
+
+int BufferAllocator::MapNameToIonHeap(const std::string &heap_name,
+                                       const std::string &ion_heap_name, unsigned int,
+                                       unsigned int, unsigned int) {
+    // See BufferAllocator.h: this codebase only ever asks for one mapping
+    // ("qcom,qseecom" -> "qsecom"), which is the only one this shim knows.
+    if (ion_heap_name != "qsecom") {
+        return -ENOSYS;
+    }
+    ion_heap_ids[heap_name] = kQseecomIonHeapId;
+    return 0;
+}
+
+// C wrapper (BufferAllocatorWrapper.h) -- for QSEEComFunc.c, a plain-C file.
+extern "C" {
+
+BufferAllocator *CreateDmabufHeapBufferAllocator(void) {
+    return new BufferAllocator();
+}
+
+void FreeDmabufHeapBufferAllocator(BufferAllocator *buffer_allocator) {
+    delete buffer_allocator;
+}
+
+int DmabufHeapAlloc(BufferAllocator *buffer_allocator, const char *heap_name, size_t len,
+                     unsigned int heap_flags, unsigned int alloc_flags) {
+    if (!buffer_allocator) {
+        return -EINVAL;
+    }
+    return buffer_allocator->Alloc(heap_name, len, heap_flags, alloc_flags);
+}
+
+int CheckIonSupport(void) {
+    return BufferAllocator().CheckIonSupport() ? 1 : 0;
+}
+
+int MapDmabufHeapNameToIonHeap(BufferAllocator *buffer_allocator, const char *heap_name,
+                                const char *ion_heap_name, unsigned int ion_heap_flags,
+                                unsigned int mapped_heap_flags, unsigned int mapped_alloc_flags) {
+    if (!buffer_allocator) {
+        return -EINVAL;
+    }
+    return buffer_allocator->MapNameToIonHeap(heap_name, ion_heap_name, ion_heap_flags,
+                                               mapped_heap_flags, mapped_alloc_flags);
+}
+
+}  // extern "C"
diff --git a/dmabufheap-compat/BufferAllocator/BufferAllocator.h b/dmabufheap-compat/BufferAllocator/BufferAllocator.h
new file mode 100644
index 0000000000000000000000000000000000000000..9539c9876420f963c8c04416548b4969ae5f72a4
--- /dev/null
+++ b/dmabufheap-compat/BufferAllocator/BufferAllocator.h
@@ -0,0 +1,68 @@
+/*
+ * Minimal compat header for the real AOSP `libdmabufheap`'s `BufferAllocator`
+ * class, absent from this Android-11 tree (it's a newer AOSP library).
+ *
+ * `Alloc()` is a REAL implementation of the real DMA-BUF Heaps ioctl protocol
+ * (see BufferAllocator.cpp) -- on a kernel with CONFIG_DMABUF_HEAPS it would
+ * actually work; this 4.14 tree never backported it (no linux/dma-heap.h UAPI
+ * header anywhere), so /dev/dma_heap/<name> genuinely doesn't exist here.
+ *
+ * That alone isn't the end of the story, though: confirmed live (a direct
+ * strace of the built fingerprint HAL) that `QSEEComFunc.c`'s own
+ * `dmabuf_alloc()` -- needed on the real FPC1145 path, not just Egistec --
+ * calls straight through this class's `Alloc()`, and this device's kernel
+ * DOES have a real, working ION allocator (`/dev/ion`, confirmed via the same
+ * strace: several successful legacy-ABI ION ioctls already happen elsewhere
+ * in this exact binary, for its own QSEECom shared-memory needs -- see
+ * the kernel's drivers/staging/android/ion/ion_legacy.c for why this kernel needs the *legacy* ABI
+ * specifically). So the ION fallback path (`CheckIonSupport()`/
+ * `MapNameToIonHeap()`, which an earlier version of this shim stubbed out as
+ * "unreachable Egistec-only code") is real and load-bearing here too --
+ * implemented for real below, not a stub.
+ */
+#pragma once
+
+#include <string>
+#include <unordered_map>
+// The real libdmabufheap header transitively pulls in unistd.h (DmaBuffer.cpp,
+// Sony's own file, calls close() without including it directly) -- match that.
+#include <unistd.h>
+
+class BufferAllocator {
+   public:
+    BufferAllocator() = default;
+    ~BufferAllocator();
+
+    BufferAllocator(const BufferAllocator &) = delete;
+    BufferAllocator &operator=(const BufferAllocator &) = delete;
+
+    // Real signature match: real AOSP's BufferAllocator::Alloc takes the same
+    // four arguments, the last two defaulted. Returns a dmabuf fd on success,
+    // a negative errno on failure. Tries /dev/dma_heap/<heap_name> first
+    // (absent on this kernel); if `heap_name` has a recorded ION mapping
+    // (see MapNameToIonHeap below), falls back to a real ION allocation
+    // instead of failing.
+    int Alloc(const std::string &heap_name, size_t len, unsigned int heap_flags = 0,
+              unsigned int alloc_flags = 0);
+
+    // Whether this device has a working /dev/ion to fall back to.
+    bool CheckIonSupport();
+
+    // Real AOSP resolves `ion_heap_name` by querying the kernel's own heap
+    // list (ION_IOC_HEAP_QUERY) and matching by name. This kernel's ION
+    // driver is old enough (see the kernel's drivers/staging/android/ion/ion_legacy.c) that querying it isn't
+    // worth relying on, and this codebase only ever asks for one specific
+    // mapping ("qcom,qseecom" -> "qsecom") -- so this records that one
+    // real, DT-confirmed heap ID (27, `qcom,ion-heap@27 { /* QSEECOM HEAP */
+    // reg = <27>; ... }` in msm8998-ion.dtsi) directly rather than building a
+    // general-purpose name resolver for a single caller.
+    int MapNameToIonHeap(const std::string &heap_name, const std::string &ion_heap_name,
+                          unsigned int ion_heap_flags = 0, unsigned int mapped_heap_flags = 0,
+                          unsigned int mapped_alloc_flags = 0);
+
+   private:
+    int heap_fd = -1;
+    std::unordered_map<std::string, unsigned int> ion_heap_ids;
+
+    int AllocFromIon(unsigned int ion_heap_id, size_t len, unsigned int flags);
+};
diff --git a/dmabufheap-compat/BufferAllocator/BufferAllocatorWrapper.h b/dmabufheap-compat/BufferAllocator/BufferAllocatorWrapper.h
new file mode 100644
index 0000000000000000000000000000000000000000..0a9ea58eac6c82efc661c8c9c9e107a2ac2e7516
--- /dev/null
+++ b/dmabufheap-compat/BufferAllocator/BufferAllocatorWrapper.h
@@ -0,0 +1,31 @@
+/*
+ * Minimal compat header for AOSP libdmabufheap's C wrapper API around
+ * BufferAllocator -- needed because QSEEComFunc.c (Sony's own file) is
+ * plain C, not C++. Same rationale as BufferAllocator.h; see there.
+ */
+#pragma once
+
+#include <stddef.h>
+
+// QSEEComFunc.c includes this as plain C, which can't parse BufferAllocator.h's
+// C++ `class` -- opaque-typedef it there instead, same trick real AOSP's own
+// wrapper header uses.
+#ifdef __cplusplus
+#include "BufferAllocator/BufferAllocator.h"
+extern "C" {
+#else
+typedef struct BufferAllocator BufferAllocator;
+#endif
+
+BufferAllocator *CreateDmabufHeapBufferAllocator(void);
+void FreeDmabufHeapBufferAllocator(BufferAllocator *buffer_allocator);
+int DmabufHeapAlloc(BufferAllocator *buffer_allocator, const char *heap_name, size_t len,
+                     unsigned int heap_flags, unsigned int alloc_flags);
+int CheckIonSupport(void);
+int MapDmabufHeapNameToIonHeap(BufferAllocator *buffer_allocator, const char *heap_name,
+                                const char *ion_heap_name, unsigned int ion_heap_flags,
+                                unsigned int mapped_heap_flags, unsigned int mapped_alloc_flags);
+
+#ifdef __cplusplus
+}
+#endif
