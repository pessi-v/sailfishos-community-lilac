From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:34:02 +0000
Subject: [PATCH] (hybris) qti kernel headers: make them available to recovery modules

hybris-boot pulls modules that are built in the recovery variant, and
those depend on qti_kernel_headers_4.14, which only declared the vendor
variant.
---
 Android.bp |    1 +
 1 file changed, 1 insertion(+)

diff --git a/Android.bp b/Android.bp
index 7e091336e0bb54c87b5b7d90699f10176c8cb2bb..012010cfa30a43cc0924c8bb917159c00d23b488 100644
--- a/Android.bp
+++ b/Android.bp
@@ -1,5 +1,6 @@
 cc_library_headers {
     name: "qti_kernel_headers_4.14",
     vendor_available: true,
+    recovery_available: true,
     export_include_dirs: ["kernel-headers"],
 }
