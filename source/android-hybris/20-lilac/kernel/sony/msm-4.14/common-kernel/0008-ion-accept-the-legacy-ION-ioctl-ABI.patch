From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:38:38 +0000
Subject: [PATCH] (lilac) ion: accept the legacy ION ioctl ABI

The msm8998 vendor libraries allocate through the ION ABI from before
4.12 (ion_user_handle_t, ION_IOC_ALLOC returning a handle, ION_IOC_FREE,
ION_IOC_SHARE/MAP). 4.14 replaced that ABI, and because _IOWR encodes the
argument size, the old commands are rejected with EINVAL, so gralloc
could not allocate any buffer.

ion_legacy.c implements the old commands on top of the 4.14 dma-buf
based allocator, with a per-file handle table; ion-ioctl.c dispatches
them before the new ones.
---
 drivers/staging/android/ion/Makefile     |    2 
 drivers/staging/android/ion/ion-ioctl.c  |   12 +
 drivers/staging/android/ion/ion.c        |    8 +
 drivers/staging/android/ion/ion.h        |   10 +
 drivers/staging/android/ion/ion_legacy.c |  473 ++++++++++++++++++++++++++++++
 drivers/staging/android/ion/ion_legacy.h |  166 +++++++++++
 6 files changed, 670 insertions(+), 1 deletion(-)

diff --git a/drivers/staging/android/ion/Makefile b/drivers/staging/android/ion/Makefile
index dc638f080d7fc98720e4045d74cb3e4aaa6f52d2..e13b5457c81728cc9cea25bf0bb5bf584cffa21b 100644
--- a/drivers/staging/android/ion/Makefile
+++ b/drivers/staging/android/ion/Makefile
@@ -1,5 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
-obj-$(CONFIG_ION) +=	ion.o ion-ioctl.o ion_heap.o \
+obj-$(CONFIG_ION) +=	ion.o ion-ioctl.o ion_heap.o ion_legacy.o \
 			ion_page_pool.o ion_system_heap.o \
 			ion_carveout_heap.o ion_chunk_heap.o \
 			ion_system_secure_heap.o ion_cma_heap.o \
diff --git a/drivers/staging/android/ion/ion-ioctl.c b/drivers/staging/android/ion/ion-ioctl.c
index 83cbcc0dcd8c445ed1ba5b06776c2b3ed4bb40c7..1e4772970488156993365f48755fffb006e956e6 100644
--- a/drivers/staging/android/ion/ion-ioctl.c
+++ b/drivers/staging/android/ion/ion-ioctl.c
@@ -19,6 +19,7 @@
 #include <linux/uaccess.h>
 
 #include "ion.h"
+#include "ion_legacy.h"
 #include "ion_system_secure_heap.h"
 
 union ion_ioctl_arg {
@@ -59,6 +60,17 @@ long ion_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 	unsigned int dir;
 	union ion_ioctl_arg data;
 
+	/*
+	 * The pre-4.12 ABI, which the msm8998 vendor blobs still speak. This
+	 * MUST be tested before the size guard below: the legacy ALLOC carries a
+	 * 32-byte struct against this union's 24, so the guard is exactly what
+	 * turns it into -EINVAL today. The smaller legacy commands would instead
+	 * fall out of the switch as -ENOTTY. Either way they never reach their
+	 * implementation without this.
+	 */
+	if (ion_legacy_is_legacy_cmd(cmd))
+		return ion_legacy_ioctl(filp, cmd, arg);
+
 	dir = ion_ioctl_dir(cmd);
 
 	if (_IOC_SIZE(cmd) > sizeof(data))
diff --git a/drivers/staging/android/ion/ion.c b/drivers/staging/android/ion/ion.c
index bac021c2c33102abc08b572ed3967e1c7b87f030..af5ab1be27bb45737a0f1fdf717e7acfe80dc52c 100644
--- a/drivers/staging/android/ion/ion.c
+++ b/drivers/staging/android/ion/ion.c
@@ -45,6 +45,7 @@
 #include <soc/qcom/secure_buffer.h>
 
 #include "ion.h"
+#include "ion_legacy.h"
 #include "ion_secure_util.h"
 
 static struct ion_device *internal_dev;
@@ -1199,6 +1200,13 @@ int ion_query_heaps(struct ion_heap_query *query)
 
 static const struct file_operations ion_fops = {
 	.owner          = THIS_MODULE,
+	/*
+	 * The legacy ABI scopes its handles to the open file, so every open of
+	 * /dev/ion needs a table. 4.14 had neither hook and left private_data
+	 * unused, so nothing here displaces existing behaviour.
+	 */
+	.open           = ion_legacy_open,
+	.release        = ion_legacy_release,
 	.unlocked_ioctl = ion_ioctl,
 #ifdef CONFIG_COMPAT
 	.compat_ioctl	= ion_ioctl,
diff --git a/drivers/staging/android/ion/ion.h b/drivers/staging/android/ion/ion.h
index 18a9b9b08315ff0ab539947210077b95dc01f889..c3988f688997c0008094c6f9e4f50ac3f76b46e2 100644
--- a/drivers/staging/android/ion/ion.h
+++ b/drivers/staging/android/ion/ion.h
@@ -301,6 +301,16 @@ int ion_heap_pages_zero(struct page *page, size_t size, pgprot_t pgprot);
 
 int ion_alloc_fd(size_t len, unsigned int heap_id_mask, unsigned int flags);
 
+/*
+ * Defined in ion.c and used by ion_alloc_fd(), but never declared in a header.
+ * The legacy ABI needs the dma_buf itself rather than an fd, and this is the
+ * same entry point the modern allocation takes -- unlike ion_alloc(), which
+ * rejects every heap type but SYSTEM/HYP_CMA/SYSTEM_SECURE.
+ */
+struct dma_buf;
+struct dma_buf *ion_alloc_dmabuf(size_t len, unsigned int heap_id_mask,
+				 unsigned int flags);
+
 /**
  * ion_heap_init_shrinker
  * @heap:		the heap
diff --git a/drivers/staging/android/ion/ion_legacy.c b/drivers/staging/android/ion/ion_legacy.c
new file mode 100644
index 0000000000000000000000000000000000000000..39ccbf721d013beebc89ff1b3f3e5d96bbbe2763
--- /dev/null
+++ b/drivers/staging/android/ion/ion_legacy.c
@@ -0,0 +1,473 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The pre-4.12 ION ioctl ABI, reimplemented on top of 4.14's dma_buf-fd ION.
+ *
+ *
+ *
+ * The two ABIs differ in their object model, not just their structs. 4.4 handed
+ * userspace an opaque per-client `ion_user_handle_t` and made it ask separately
+ * for a shareable fd; 4.14 returns the dma_buf fd from the allocation itself and
+ * has no handles at all. So this is not a struct-shuffling shim: it has to
+ * re-create the handle namespace, which is what the per-open idr below is.
+ *
+ * The mapping is:
+ *
+ *     legacy handle  ->  struct dma_buf *   (one reference held by the table)
+ *
+ * ALLOC   allocate a dma_buf, park it in the table, return its handle
+ * IMPORT  dma_buf_get(fd), park it, return a handle
+ * MAP     look the handle up, hand out an fd for the same dma_buf
+ * SHARE   identical to MAP in the legacy ABI -- both just produce an fd
+ * FREE    drop the table's reference
+ * SYNC    the CPU-access bracket, which is where 4.14 put cache maintenance
+ * CUSTOM  msm's CLEAN/INV/CLEAN_INV cache ops
+ *
+ * The refcounting is the part worth being careful about, and it is commented
+ * where it happens.
+ */
+
+#include <linux/dma-buf.h>
+#include <linux/dma-direction.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/idr.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "ion.h"
+#include "ion_legacy.h"
+
+/**
+ * struct ion_legacy_client - the handle namespace for one open of /dev/ion
+ *
+ * The legacy ABI scoped handles to the open file, and blobs rely on that: two
+ * processes may hold the same handle value meaning different buffers. So this
+ * hangs off filp->private_data, which 4.14's ion leaves unused.
+ */
+struct ion_legacy_client {
+	struct idr handles;
+	struct mutex lock;
+};
+
+int ion_legacy_open(struct inode *inode, struct file *filp)
+{
+	struct ion_legacy_client *client;
+
+	client = kzalloc(sizeof(*client), GFP_KERNEL);
+	if (!client)
+		return -ENOMEM;
+
+	idr_init(&client->handles);
+	mutex_init(&client->lock);
+	filp->private_data = client;
+
+	return 0;
+}
+
+int ion_legacy_release(struct inode *inode, struct file *filp)
+{
+	struct ion_legacy_client *client = filp->private_data;
+	struct dma_buf *dmabuf;
+	int id;
+
+	if (!client)
+		return 0;
+
+	/*
+	 * 4.4 cleaned a client's handles up on close and callers depend on it --
+	 * gralloc, for one, leaks handles deliberately on some error paths.
+	 * Anything still in the table owns a dma_buf reference that nothing else
+	 * will ever drop, so this is not optional tidiness.
+	 */
+	mutex_lock(&client->lock);
+	idr_for_each_entry(&client->handles, dmabuf, id)
+		dma_buf_put(dmabuf);
+	idr_destroy(&client->handles);
+	mutex_unlock(&client->lock);
+
+	mutex_destroy(&client->lock);
+	kfree(client);
+	filp->private_data = NULL;
+
+	return 0;
+}
+
+static struct dma_buf *ion_legacy_lookup(struct ion_legacy_client *client,
+					 ion_user_handle_t handle)
+{
+	struct dma_buf *dmabuf;
+
+	mutex_lock(&client->lock);
+	dmabuf = idr_find(&client->handles, handle);
+	mutex_unlock(&client->lock);
+
+	return dmabuf;
+}
+
+static int ion_legacy_insert(struct ion_legacy_client *client,
+			     struct dma_buf *dmabuf)
+{
+	int id;
+
+	mutex_lock(&client->lock);
+	/* 0 is the legacy ABI's "no handle", so ids start at 1 */
+	id = idr_alloc(&client->handles, dmabuf, 1, 0, GFP_KERNEL);
+	mutex_unlock(&client->lock);
+
+	return id;
+}
+
+static int ion_legacy_drop(struct ion_legacy_client *client,
+			   ion_user_handle_t handle)
+{
+	struct dma_buf *dmabuf;
+
+	mutex_lock(&client->lock);
+	dmabuf = idr_remove(&client->handles, handle);
+	mutex_unlock(&client->lock);
+
+	if (!dmabuf)
+		return -EINVAL;
+
+	dma_buf_put(dmabuf);
+
+	return 0;
+}
+
+static int ion_legacy_do_alloc(struct ion_legacy_client *client, u64 len,
+			       u32 heap_id_mask, u32 flags,
+			       ion_user_handle_t *out_handle)
+{
+	struct dma_buf *dmabuf;
+	int id;
+
+	/*
+	 * @align is accepted and ignored. 4.12 dropped it from the ABI and no
+	 * 4.14 heap honours it; the callers here pass the page size, which the
+	 * allocator already guarantees.
+	 *
+	 * ion_alloc_dmabuf() rather than ion_alloc(): the latter rejects every
+	 * heap type except SYSTEM/HYP_CMA/SYSTEM_SECURE, and the blobs allocate
+	 * from carveout and qsecom heaps too. ion_alloc_fd() -- the new ABI's
+	 * own path -- uses ion_alloc_dmabuf, so this behaves identically to a
+	 * modern allocation.
+	 */
+	dmabuf = ion_alloc_dmabuf(len, heap_id_mask, flags);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	id = ion_legacy_insert(client, dmabuf);
+	if (id < 0) {
+		dma_buf_put(dmabuf);
+		return id;
+	}
+
+	*out_handle = id;
+
+	return 0;
+}
+
+static int ion_legacy_do_share(struct ion_legacy_client *client,
+			       ion_user_handle_t handle, int *out_fd)
+{
+	struct dma_buf *dmabuf;
+	int fd;
+
+	dmabuf = ion_legacy_lookup(client, handle);
+	if (!dmabuf)
+		return -EINVAL;
+
+	/*
+	 * dma_buf_fd() CONSUMES a reference: fd_install() takes over the file
+	 * reference the caller held. Take a fresh one for the fd so the table
+	 * keeps its own -- otherwise closing the fd frees a buffer the handle
+	 * still points at, which is precisely the use-after-free that the
+	 * legacy handle model invites.
+	 */
+	get_dma_buf(dmabuf);
+
+	fd = dma_buf_fd(dmabuf, O_CLOEXEC);
+	if (fd < 0) {
+		dma_buf_put(dmabuf);
+		return fd;
+	}
+
+	*out_fd = fd;
+
+	return 0;
+}
+
+static int ion_legacy_do_import(struct ion_legacy_client *client, int fd,
+				ion_user_handle_t *out_handle)
+{
+	struct dma_buf *dmabuf;
+	int id;
+
+	/* dma_buf_get() returns a new reference, which the table then owns */
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	id = ion_legacy_insert(client, dmabuf);
+	if (id < 0) {
+		dma_buf_put(dmabuf);
+		return id;
+	}
+
+	*out_handle = id;
+
+	return 0;
+}
+
+/*
+ * Cache maintenance.
+ *
+ * 4.14 expresses it as a bracket -- begin_cpu_access() invalidates,
+ * end_cpu_access() cleans -- and ION's implementation tracks state across the
+ * pair. Issuing half a bracket to mimic a one-way legacy op would leave that
+ * state inconsistent, so both halves are always issued and the *direction*
+ * carries the meaning. That does marginally more work than 4.4 did for CLEAN
+ * and INV; it is never less, so it is never wrong.
+ */
+static int ion_legacy_cache_op(struct dma_buf *dmabuf, unsigned int op,
+			       u32 offset, u32 length)
+{
+	enum dma_data_direction dir;
+	bool partial = length != 0;
+	int ret;
+
+	switch (op) {
+	case ION_LEGACY_IOC_CLEAN_CACHES:
+	case ION_LEGACY_IOC_CLEAN_CACHES32:
+		dir = DMA_TO_DEVICE;
+		break;
+	case ION_LEGACY_IOC_INV_CACHES:
+	case ION_LEGACY_IOC_INV_CACHES32:
+		dir = DMA_FROM_DEVICE;
+		break;
+	case ION_LEGACY_IOC_CLEAN_INV_CACHES:
+	case ION_LEGACY_IOC_CLEAN_INV_CACHES32:
+		dir = DMA_BIDIRECTIONAL;
+		break;
+	default:
+		return -ENOTTY;
+	}
+
+	if (partial) {
+		ret = dma_buf_begin_cpu_access_partial(dmabuf, dir, offset,
+						       length);
+		if (ret)
+			return ret;
+		return dma_buf_end_cpu_access_partial(dmabuf, dir, offset,
+						      length);
+	}
+
+	ret = dma_buf_begin_cpu_access(dmabuf, dir);
+	if (ret)
+		return ret;
+
+	return dma_buf_end_cpu_access(dmabuf, dir);
+}
+
+static int ion_legacy_custom(struct ion_legacy_client *client, unsigned int op,
+			     void __user *uarg, bool compat)
+{
+	struct dma_buf *dmabuf;
+	ion_user_handle_t handle;
+	u32 offset, length;
+	bool put = false;
+	int fd, ret;
+
+	if (compat) {
+		struct ion_legacy_flush_data32 data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+		handle = data.handle;
+		fd = data.fd;
+		offset = data.offset;
+		length = data.length;
+	} else {
+		struct ion_legacy_flush_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+		handle = data.handle;
+		fd = data.fd;
+		offset = data.offset;
+		length = data.length;
+	}
+
+	/*
+	 * The payload carries both a handle and an fd, and callers set one or
+	 * the other depending on vintage. Prefer the fd: it is unambiguous, and
+	 * a buffer reached that way need not be in this client's table at all.
+	 */
+	if (fd >= 0) {
+		dmabuf = dma_buf_get(fd);
+		if (IS_ERR(dmabuf))
+			return PTR_ERR(dmabuf);
+		put = true;
+	} else {
+		dmabuf = ion_legacy_lookup(client, handle);
+		if (!dmabuf)
+			return -EINVAL;
+	}
+
+	ret = ion_legacy_cache_op(dmabuf, op, offset, length);
+
+	if (put)
+		dma_buf_put(dmabuf);
+
+	return ret;
+}
+
+static int ion_legacy_sync(int fd)
+{
+	struct dma_buf *dmabuf;
+	int ret;
+
+	dmabuf = dma_buf_get(fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	/*
+	 * Legacy ION_IOC_SYNC meant "the CPU touched this, make it coherent for
+	 * devices". Bidirectional is the conservative reading, and matches what
+	 * 4.4's msm ion did for this ioctl.
+	 */
+	ret = dma_buf_begin_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+	if (!ret)
+		ret = dma_buf_end_cpu_access(dmabuf, DMA_BIDIRECTIONAL);
+
+	dma_buf_put(dmabuf);
+
+	return ret;
+}
+
+long ion_legacy_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	struct ion_legacy_client *client = filp->private_data;
+	void __user *uarg = (void __user *)arg;
+	int ret;
+
+	if (!client)
+		return -EINVAL;
+
+	switch (cmd) {
+	case ION_LEGACY_IOC_ALLOC: {
+		struct ion_legacy_allocation_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		ret = ion_legacy_do_alloc(client, data.len, data.heap_id_mask,
+					  data.flags, &data.handle);
+		if (ret)
+			return ret;
+
+		if (copy_to_user(uarg, &data, sizeof(data))) {
+			ion_legacy_drop(client, data.handle);
+			return -EFAULT;
+		}
+
+		return 0;
+	}
+	case ION_LEGACY_IOC_ALLOC32: {
+		struct ion_legacy_allocation_data32 data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		ret = ion_legacy_do_alloc(client, data.len, data.heap_id_mask,
+					  data.flags, &data.handle);
+		if (ret)
+			return ret;
+
+		if (copy_to_user(uarg, &data, sizeof(data))) {
+			ion_legacy_drop(client, data.handle);
+			return -EFAULT;
+		}
+
+		return 0;
+	}
+	case ION_LEGACY_IOC_FREE: {
+		struct ion_legacy_handle_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		return ion_legacy_drop(client, data.handle);
+	}
+	case ION_LEGACY_IOC_MAP:
+	case ION_LEGACY_IOC_SHARE: {
+		struct ion_legacy_fd_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		ret = ion_legacy_do_share(client, data.handle, &data.fd);
+		if (ret)
+			return ret;
+
+		if (copy_to_user(uarg, &data, sizeof(data))) {
+			/*
+			 * The fd is already installed in the caller's table and
+			 * cannot be recalled from here; it will go when the
+			 * process does. Nothing leaks in the kernel.
+			 */
+			return -EFAULT;
+		}
+
+		return 0;
+	}
+	case ION_LEGACY_IOC_IMPORT: {
+		struct ion_legacy_fd_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		ret = ion_legacy_do_import(client, data.fd, &data.handle);
+		if (ret)
+			return ret;
+
+		if (copy_to_user(uarg, &data, sizeof(data))) {
+			ion_legacy_drop(client, data.handle);
+			return -EFAULT;
+		}
+
+		return 0;
+	}
+	case ION_LEGACY_IOC_SYNC: {
+		struct ion_legacy_fd_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		return ion_legacy_sync(data.fd);
+	}
+	case ION_LEGACY_IOC_CUSTOM: {
+		struct ion_legacy_custom_data data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		return ion_legacy_custom(client, data.cmd,
+					 (void __user *)(uintptr_t)data.arg,
+					 false);
+	}
+	case ION_LEGACY_IOC_CUSTOM32: {
+		struct ion_legacy_custom_data32 data;
+
+		if (copy_from_user(&data, uarg, sizeof(data)))
+			return -EFAULT;
+
+		return ion_legacy_custom(client, data.cmd,
+					 (void __user *)(uintptr_t)data.arg,
+					 true);
+	}
+	default:
+		return -ENOTTY;
+	}
+}
diff --git a/drivers/staging/android/ion/ion_legacy.h b/drivers/staging/android/ion/ion_legacy.h
new file mode 100644
index 0000000000000000000000000000000000000000..6619cce8cf93e3e2e484a12ce977dba7b57245a2
--- /dev/null
+++ b/drivers/staging/android/ion/ion_legacy.h
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The pre-4.12 ("legacy") ION ioctl ABI, for vendor blobs compiled against it.
+ *
+ * msm8998's Android 9 blobs -- gralloc, camera, video,
+ * audio, everything that allocates -- speak the ION ABI that 4.4 had. 4.14
+ * replaced it wholesale: allocation now returns a dma_buf fd directly, and the
+ * opaque per-client `ion_user_handle_t` and its ioctls are gone.
+ *
+ * _IOWR() encodes sizeof(struct) into the command number, so the two ABIs do
+ * not merely differ in behaviour, they produce *different ioctl numbers*, and
+ * 4.14's dispatcher rejects the old ones before it even looks at the command:
+ *
+ *     ioctl(5, _IOC(_IOC_READ|_IOC_WRITE, 0x49, 0, 0x20), ...) = -1 EINVAL
+ *
+ * because `_IOC_SIZE(cmd) > sizeof(union ion_ioctl_arg)` is 32 > 24.
+ *
+ * The structs below are therefore spelled with fixed-width types chosen to
+ * reproduce the 4.4 layouts exactly, not to be pretty:
+ *
+ *   4.4:  struct ion_allocation_data { size_t len; size_t align;
+ *                                      unsigned int heap_id_mask;
+ *                                      unsigned int flags;
+ *                                      ion_user_handle_t handle; };
+ *
+ * On LP64 that is 8+8+4+4+4 padded to 32; on ILP32 it is 20. A 32-bit caller
+ * therefore issues a *different* command for the same operation, which is why
+ * the 32-bit variants below exist rather than being folded in. (`compat_ioctl`
+ * points at the same dispatcher, so both arrive here.)
+ */
+#ifndef _ION_LEGACY_H
+#define _ION_LEGACY_H
+
+#include <linux/fs.h>
+#include <linux/types.h>
+
+typedef int ion_user_handle_t;
+
+struct ion_legacy_allocation_data {
+	__u64 len;
+	__u64 align;
+	__u32 heap_id_mask;
+	__u32 flags;
+	ion_user_handle_t handle;
+};
+
+struct ion_legacy_allocation_data32 {
+	__u32 len;
+	__u32 align;
+	__u32 heap_id_mask;
+	__u32 flags;
+	ion_user_handle_t handle;
+};
+
+struct ion_legacy_handle_data {
+	ion_user_handle_t handle;
+};
+
+struct ion_legacy_fd_data {
+	ion_user_handle_t handle;
+	int fd;
+};
+
+struct ion_legacy_custom_data {
+	__u32 cmd;
+	__aligned_u64 arg;
+};
+
+struct ion_legacy_custom_data32 {
+	__u32 cmd;
+	__u32 arg;
+};
+
+/* msm cache-maintenance payload, reached through ION_IOC_CUSTOM */
+struct ion_legacy_flush_data {
+	ion_user_handle_t handle;
+	int fd;
+	__aligned_u64 vaddr;
+	__u32 offset;
+	__u32 length;
+};
+
+struct ion_legacy_flush_data32 {
+	ion_user_handle_t handle;
+	int fd;
+	__u32 vaddr;
+	__u32 offset;
+	__u32 length;
+};
+
+#define ION_LEGACY_IOC_MAGIC		'I'
+#define ION_LEGACY_IOC_MSM_MAGIC	'M'
+
+/*
+ * nr 0 collides with 4.14's ION_IOC_ALLOC *by number only* -- the sizes differ
+ * (32/20 vs 24), so the full commands are distinct. 4.14 uses nr 8 for
+ * HEAP_QUERY and 'M' nr 3/4 for PREFETCH/DRAIN; nrs 1,2,4,5,6,7 are unused
+ * there, so nothing below can shadow a live command.
+ */
+#define ION_LEGACY_IOC_ALLOC \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 0, struct ion_legacy_allocation_data)
+#define ION_LEGACY_IOC_ALLOC32 \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 0, struct ion_legacy_allocation_data32)
+#define ION_LEGACY_IOC_FREE \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 1, struct ion_legacy_handle_data)
+#define ION_LEGACY_IOC_MAP \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 2, struct ion_legacy_fd_data)
+#define ION_LEGACY_IOC_SHARE \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 4, struct ion_legacy_fd_data)
+#define ION_LEGACY_IOC_IMPORT \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 5, struct ion_legacy_fd_data)
+#define ION_LEGACY_IOC_CUSTOM \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 6, struct ion_legacy_custom_data)
+#define ION_LEGACY_IOC_CUSTOM32 \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 6, struct ion_legacy_custom_data32)
+#define ION_LEGACY_IOC_SYNC \
+	_IOWR(ION_LEGACY_IOC_MAGIC, 7, struct ion_legacy_fd_data)
+
+/* ION_IOC_CUSTOM sub-commands */
+#define ION_LEGACY_IOC_CLEAN_CACHES \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 0, struct ion_legacy_flush_data)
+#define ION_LEGACY_IOC_INV_CACHES \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 1, struct ion_legacy_flush_data)
+#define ION_LEGACY_IOC_CLEAN_INV_CACHES \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 2, struct ion_legacy_flush_data)
+#define ION_LEGACY_IOC_CLEAN_CACHES32 \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 0, struct ion_legacy_flush_data32)
+#define ION_LEGACY_IOC_INV_CACHES32 \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 1, struct ion_legacy_flush_data32)
+#define ION_LEGACY_IOC_CLEAN_INV_CACHES32 \
+	_IOWR(ION_LEGACY_IOC_MSM_MAGIC, 2, struct ion_legacy_flush_data32)
+
+/**
+ * ion_legacy_is_legacy_cmd - does this command belong to the pre-4.12 ABI?
+ *
+ * Must be consulted by ion_ioctl() *before* its `_IOC_SIZE(cmd) > sizeof(data)`
+ * guard, which is what currently turns the blobs' ALLOC into -EINVAL. The
+ * smaller legacy commands would otherwise reach the switch and fall out of it
+ * as -ENOTTY, so every one of them has to be claimed here.
+ */
+static inline bool ion_legacy_is_legacy_cmd(unsigned int cmd)
+{
+	if (_IOC_TYPE(cmd) != ION_LEGACY_IOC_MAGIC)
+		return false;
+
+	switch (cmd) {
+	case ION_LEGACY_IOC_ALLOC:
+	case ION_LEGACY_IOC_ALLOC32:
+	case ION_LEGACY_IOC_FREE:
+	case ION_LEGACY_IOC_MAP:
+	case ION_LEGACY_IOC_SHARE:
+	case ION_LEGACY_IOC_IMPORT:
+	case ION_LEGACY_IOC_SYNC:
+	case ION_LEGACY_IOC_CUSTOM:
+	case ION_LEGACY_IOC_CUSTOM32:
+		return true;
+	default:
+		return false;
+	}
+}
+
+long ion_legacy_ioctl(struct file *filp, unsigned int cmd, unsigned long arg);
+int ion_legacy_open(struct inode *inode, struct file *filp);
+int ion_legacy_release(struct inode *inode, struct file *filp);
+
+#endif /* _ION_LEGACY_H */
