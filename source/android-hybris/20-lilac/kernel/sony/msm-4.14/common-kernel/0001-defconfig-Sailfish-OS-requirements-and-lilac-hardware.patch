From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:37:33 +0000
Subject: [PATCH] (lilac) defconfig: Sailfish OS requirements and lilac hardware

Sailfish OS / hybris:
- SYSVIPC, DEVTMPFS(_MOUNT), AUTOFS4_FS, VT: checked by the hybris boot.
- FHANDLE, UTS_NS, IPC_NS, BLK_CGROUP: needed by systemd.
- PID_NS, USER_NS: sailjail/firejail; without them clone() fails and
  no sandboxed application starts.
- BT_HCIVHCI: bluebinder needs /dev/vhci.
- BT_RFCOMM(_TTY), BT_BNEP(+filters), BT_HIDP: Bluetooth profiles.
- USB_CONFIGFS_ECM: USB networking.
- PM_AUTOSLEEP: suspend driven by the kernel autosleep interface.
- CC_STACKPROTECTOR_NONE, no COMPAT_VDSO, ARM_ARCH_TIMER_VCT_ACCESS,
  no DUMMY: as in the configuration the device was brought up with.

Hardware:
- ION_SYSTEM/CARVEOUT/CHUNK/CMA_HEAP: 4.14 split the ION heaps into
  their own options and the defconfig kept only ION, so no heap could be
  created and gralloc allocations failed.
- SENSORS_TCS3490: the RGBC-IR sensor; the camera HAL reads its sysfs
  node at start and reports no cameras without it.
- INPUT_STMVL53L0: the laser rangefinder used for autofocus.
- IOMMU_DEBUG, IOMMU_DEBUG_TRACKING, IOMMU_TESTS off: debug options.
---
 arch/arm64/configs/aosp_yoshino_lilac_defconfig |   64 +++++++++++++++++++----
 1 file changed, 54 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/configs/aosp_yoshino_lilac_defconfig b/arch/arm64/configs/aosp_yoshino_lilac_defconfig
index 95e808cf82b53cd53b15e54e4285a572a8b41091..a6181e0c93704b3130588bc43773ffc0ba4e8ee3 100644
--- a/arch/arm64/configs/aosp_yoshino_lilac_defconfig
+++ b/arch/arm64/configs/aosp_yoshino_lilac_defconfig
@@ -1,4 +1,3 @@
-# CONFIG_FHANDLE is not set
 CONFIG_AUDIT=y
 CONFIG_NO_HZ=y
 CONFIG_HIGH_RES_TIMERS=y
@@ -22,8 +21,6 @@ CONFIG_CGROUP_FREEZER=y
 CONFIG_CGROUP_CPUACCT=y
 CONFIG_CGROUP_BPF=y
 CONFIG_NAMESPACES=y
-# CONFIG_UTS_NS is not set
-# CONFIG_PID_NS is not set
 CONFIG_SCHED_TUNE=y
 CONFIG_DEFAULT_USE_ENERGY_AWARE=y
 CONFIG_BLK_DEV_INITRD=y
@@ -42,7 +39,7 @@ CONFIG_EMBEDDED=y
 CONFIG_PROFILING=y
 CONFIG_KPROBES=y
 CONFIG_JUMP_LABEL=y
-CONFIG_CC_STACKPROTECTOR_REGULAR=y
+CONFIG_CC_STACKPROTECTOR_NONE=y
 CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
 # CONFIG_VMAP_STACK is not set
 CONFIG_REFCOUNT_FULL=y
@@ -84,7 +81,8 @@ CONFIG_ARM64_SW_TTBR0_PAN=y
 CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
 # CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS is not set
 CONFIG_COMPAT=y
-CONFIG_COMPAT_VDSO=y
+# CONFIG_COMPAT_VDSO is not set
+CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y
 CONFIG_PM_WAKELOCKS=y
 CONFIG_PM_WAKELOCKS_LIMIT=0
 # CONFIG_PM_WAKELOCKS_GC is not set
@@ -298,7 +296,6 @@ CONFIG_DM_VERITY_FEC=y
 CONFIG_DM_ANDROID_VERITY=y
 CONFIG_DM_BOW=y
 CONFIG_NETDEVICES=y
-CONFIG_DUMMY=y
 CONFIG_MACVLAN=y
 CONFIG_MACVTAP=y
 CONFIG_IPVLAN=y
@@ -420,7 +417,7 @@ CONFIG_INPUT_GPIO=y
 CONFIG_INPUT_BU520X1NVX=y
 CONFIG_FPC1145_PLATFORM=y
 CONFIG_SERIO_LIBPS2=y
-# CONFIG_VT is not set
+CONFIG_VT=y
 # CONFIG_LEGACY_PTYS is not set
 # CONFIG_DEVMEM is not set
 CONFIG_SERIAL_MSM=y
@@ -517,6 +514,12 @@ CONFIG_MSMB_JPEG=y
 CONFIG_MSM_FD=y
 CONFIG_MSM_JPEGDMA=y
 CONFIG_SONY_CAM_V4L2=y
+# lilac: the AMS tcs3490 RGBC-IR sensor. excalibur's camera
+# HAL reads /sys/devices/virtual/input/rgbcir_sensor/chip_pow during
+# init and aborts (num 0 cameras) if it is absent. Driver source and
+# the tcs3490@72 DT node are already in the tree; only this switch was
+# dropped from the 4.14 defconfig (present in Sony's 4.4 config).
+CONFIG_SENSORS_TCS3490=y
 CONFIG_MSM_VIDC_3X_V4L2=y
 CONFIG_MSM_VIDC_3X_VMEM=y
 CONFIG_MSM_VIDC_3X_GOVERNORS=y
@@ -623,6 +626,15 @@ CONFIG_ANDROID_LOW_MEMORY_KILLER=y
 CONFIG_ANDROID_LOW_MEMORY_KILLER_TNG=y
 CONFIG_ANDROID_LOW_MEMORY_KILLER_STATS=y
 CONFIG_ION=y
+# lilac: 4.14 split the ION heaps into their own configs and this
+# defconfig kept only CONFIG_ION. Without a heap type compiled in,
+# msm_ion_of parses the DT heaps and can create none, so ION_IOC_ALLOC
+# fails EINVAL and gralloc returns NULL buffer handles. 4.4 got these via
+# CONFIG_ION_MSM=y, which no longer exists.
+CONFIG_ION_SYSTEM_HEAP=y
+CONFIG_ION_CARVEOUT_HEAP=y
+CONFIG_ION_CHUNK_HEAP=y
+CONFIG_ION_CMA_HEAP=y
 CONFIG_QCA_CLD_WLAN=y
 CONFIG_QCACLD_WLAN_LFR3=y
 CONFIG_WLAN_FEATURE_11W=y
@@ -666,9 +678,9 @@ CONFIG_QCOM_APCS_IPC=y
 CONFIG_IOMMU_IO_PGTABLE_FAST=y
 CONFIG_ARM_SMMU=y
 CONFIG_QCOM_LAZY_MAPPING=y
-CONFIG_IOMMU_DEBUG=y
-CONFIG_IOMMU_DEBUG_TRACKING=y
-CONFIG_IOMMU_TESTS=y
+# CONFIG_IOMMU_DEBUG is not set
+# CONFIG_IOMMU_DEBUG_TRACKING is not set
+# CONFIG_IOMMU_TESTS is not set
 CONFIG_REMOTEPROC=y
 CONFIG_RPMSG_CHAR=y
 CONFIG_RPMSG_QCOM_GLINK_RPM=y
@@ -887,3 +899,35 @@ CONFIG_SND_SOC_MSM_SDW=y
 CONFIG_SND_SOC_MSM_HDMI_CODEC_RX=y
 CONFIG_SND_SOC_WCD_CPE_SOMC_EXT=y
 CONFIG_SND_SOC_MSM8998=y
+
+# --- Sailfish OS / hybris requirements ---
+# hybris-boot check_kernel_config
+CONFIG_SYSVIPC=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_AUTOFS4_FS=y
+# CONFIG_DUMMY is not set
+
+# systemd
+CONFIG_FHANDLE=y
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_BLK_CGROUP=y
+
+# sailjail/firejail: without these clone() returns EINVAL and nothing sandboxed starts
+CONFIG_PID_NS=y
+CONFIG_USER_NS=y
+
+# bluebinder needs /dev/vhci
+CONFIG_BT_HCIVHCI=y
+
+# USB networking to the host
+CONFIG_USB_CONFIGFS_ECM=y
+CONFIG_INPUT_STMVL53L0=y
+CONFIG_PM_AUTOSLEEP=y
+CONFIG_BT_RFCOMM=y
+CONFIG_BT_RFCOMM_TTY=y
+CONFIG_BT_BNEP=y
+CONFIG_BT_BNEP_MC_FILTER=y
+CONFIG_BT_BNEP_PROTO_FILTER=y
+CONFIG_BT_HIDP=y
