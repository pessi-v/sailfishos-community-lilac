From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:39:09 +0000
Subject: [PATCH] (lilac) vdso: build with the Android GCC toolchain's binutils

Build-environment fix: the vDSO is linked by the compiler driver, which
needs the aarch64 binutils of the Android GCC prebuilts on its search
path, and vgettimeofday.o must use clang's integrated assembler.
---
 arch/arm64/kernel/vdso/Makefile |    3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/vdso/Makefile b/arch/arm64/kernel/vdso/Makefile
index 89df44e87ab0e38b934c25e44fcd9d3f18bc240c..6e2d3e1036151cdd6ca815e9178484a5d09c638c 100644
--- a/arch/arm64/kernel/vdso/Makefile
+++ b/arch/arm64/kernel/vdso/Makefile
@@ -16,13 +16,14 @@ obj-vdso-c := $(addprefix $(obj)/, $(obj-vdso-c))
 obj-vdso   := $(obj-vdso-c) $(obj-vdso-s)
 
 ccflags-y := -shared -fno-common -fno-builtin -fno-stack-protector -ffixed-x18
+ccflags-y += -B$(srctree)/../../../../prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin
 ccflags-y += -DDISABLE_BRANCH_PROFILING
 ccflags-y += -nostdlib -Wl,-soname=linux-vdso.so.1 -Wl,--hash-style=sysv
 ccflags-y += $(DISABLE_LTO) $(DISABLE_SCS)
 
 # Force -O2 to avoid libgcc dependencies
 CFLAGS_REMOVE_vgettimeofday.o = -pg -Os
-CFLAGS_vgettimeofday.o = -O2 -fPIC
+CFLAGS_vgettimeofday.o = -O2 -fPIC -fintegrated-as
 ifneq ($(cc-name),clang)
 CFLAGS_vgettimeofday.o += -mcmodel=tiny
 endif
