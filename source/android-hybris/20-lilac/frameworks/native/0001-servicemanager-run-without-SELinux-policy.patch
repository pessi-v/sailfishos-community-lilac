From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pessi-v <pessimo@posteo.net>
Date: Sun, 15 Nov 2026 16:24:50 +0000
Subject: [PATCH] (hybris) servicemanager: run without a loaded SELinux policy

Sailfish OS boots with SELinux built into the kernel but with no policy
loaded and selinuxfs not mounted. servicemanager aborts in its Access
constructor on CHECK(selinux_status_open(...)), so /dev/binder never gets a
context manager.

Probe is_selinux_enabled() once; when SELinux is not enabled, skip the
SELinux setup and allow every access check, the same as a permissive
system. With a policy loaded nothing changes.
---
 cmds/servicemanager/Access.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/cmds/servicemanager/Access.cpp b/cmds/servicemanager/Access.cpp
index b7e520f2f1cb1e464f0f291455cf182b782666a7..f3889b6dbd2ff21217357c9b28337269ad07557b 100644
--- a/cmds/servicemanager/Access.cpp
+++ b/cmds/servicemanager/Access.cpp
@@ -21,6 +21,7 @@
 #include <log/log_safetynet.h>
 #include <selinux/android.h>
 #include <selinux/avc.h>
+#include <selinux/selinux.h>
 
 namespace android {
 
@@ -30,6 +31,13 @@ constexpr bool kIsVendor = true;
 constexpr bool kIsVendor = false;
 #endif
 
+// hybris: this system boots with no SELinux policy loaded. Probe once and
+// degrade to permissive rather than aborting. See patch header.
+static bool seUsable() {
+    static const bool kUsable = (is_selinux_enabled() == 1);
+    return kUsable;
+}
+
 static std::string getPidcon(pid_t pid) {
     android_errorWriteLog(0x534e4554, "121035042");
 
@@ -88,6 +96,11 @@ Access::Access() {
     cb.func_log = kIsVendor ? selinux_vendor_log_callback : selinux_log_callback;
     selinux_set_callback(SELINUX_CB_LOG, cb);
 
+    if (!seUsable()) {
+        LOG(WARNING) << "SELinux not enabled; servicemanager access control disabled";
+        return;
+    }
+
     CHECK(selinux_status_open(true /*fallback*/) >= 0);
 
     CHECK(getcon(&mThisProcessContext) == 0);
@@ -124,6 +137,8 @@ bool Access::canList(const CallingContext& ctx) {
 
 bool Access::actionAllowed(const CallingContext& sctx, const char* tctx, const char* perm,
         const std::string& tname) {
+    if (!seUsable()) return true;
+
     const char* tclass = "service_manager";
 
     AuditCallbackData data = {
@@ -136,6 +151,8 @@ bool Access::actionAllowed(const CallingContext& sctx, const char* tctx, const c
 }
 
 bool Access::actionAllowedFromLookup(const CallingContext& sctx, const std::string& name, const char *perm) {
+    if (!seUsable()) return true;
+
     char *tctx = nullptr;
     if (selabel_lookup(getSehandle(), &tctx, name.c_str(), SELABEL_CTX_ANDROID_SERVICE) != 0) {
         LOG(ERROR) << "SELinux: No match for " << name << " in service_contexts.\n";
